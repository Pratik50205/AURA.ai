# ==============================================================================
# AURA.ai — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local and populate the values below.
# NEVER commit your actual .env or .env.local files containing live secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Generate a strong 32+ character random string for production (e.g. `openssl rand -base64 32`)
AUTH_SECRET="your-super-secret-auth-key-32-chars-minimum"
NEXTAUTH_SECRET="your-super-secret-auth-key-32-chars-minimum"
NEXTAUTH_URL="http://localhost:3000"

# Comma-separated list of administrative emails that receive the ADMIN role
ADMIN_EMAILS="admin@aura.ai,lead@aura.ai"

# OAuth Providers (Optional: leave empty if only using email/password credentials)
GITHUB_ID=""
GITHUB_SECRET=""
GOOGLE_ID=""
GOOGLE_SECRET=""

# ------------------------------------------------------------------------------
# 2. DATABASE PERSISTENCE
# ------------------------------------------------------------------------------
# SQLite local development default:
DATABASE_URL="file:./prisma/dev.db"

# Production PostgreSQL example (Supabase, Neon, AWS RDS, Docker):
# DATABASE_URL="postgresql://user:password@localhost:5432/aura_db?schema=public"

# ------------------------------------------------------------------------------
# 3. AI / ML MICROSERVICE & INFERENCE BACKEND
# ------------------------------------------------------------------------------
# URL for the FastAPI intelligence microservice (FAISS + BM25 + PyTorch Ranker)
AURA_INTELLIGENCE_URL="http://127.0.0.1:8000"
AURA_AIML_URL="http://127.0.0.1:8000"

# ------------------------------------------------------------------------------
# 4. LLM INFERENCE PROVIDERS (AURA COPILOT)
# ------------------------------------------------------------------------------
# Local Ollama instance (recommended for local privacy & zero API cost):
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3"

# Cloud LLM Provider Keys (Optional: if you prefer cloud inference):
# Google Gemini:
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Groq Cloud (ultra-fast inference):
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# OpenAI:
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
