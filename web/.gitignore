# ==============================================================================
# AURA.ai Web Frontend — Git Ignore Configuration
# ==============================================================================

# Markdown Documentation (Internal notes ignored; README allowed)
*.md
**/*.md
!README.md

# Dependencies
node_modules/
.pnp
.pnp.js

# Testing
coverage/
.nyc_output/

# Next.js & Build Outputs
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Local Environment & Secrets
.env*.local
.env
.env.production
.env.development
!.env.example

# Certificates & Private Keys
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Database & SQLite Storage (DO NOT COMMIT)
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
dev.db
prisma/dev.db

# Vercel & Deployment
.vercel

# Debug & Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# IDE & OS
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
.claude/
.agents/
