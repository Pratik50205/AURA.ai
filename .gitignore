# ==============================================================================
# AURA.ai — Master Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MARKDOWN FILES (Internal notes, PRDs, trackers & audit reports ignored)
# Public docs allowed: README, ARCHITECTURE, and WALKTHROUGH
# ------------------------------------------------------------------------------
*.md
**/*.md
!README.md
!**/README.md
!docs/ARCHITECTURE.md
!ARCHITECTURE.md
!docs/WALKTHROUGH.md
!WALKTHROUGH.md

# ------------------------------------------------------------------------------
# 2. CONFIDENTIAL ENVIRONMENT & CREDENTIAL FILES
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
*.env
*.env.local
!.env.example
!web/.env.example

# Private Keys, Certificates & Tokens
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.id_rsa
*.pub
credentials.json
serviceAccountKey*.json
firebase-adminsdk*.json
client_secret*.json
*.keystore
*.jks

# External Reference Folder (Private project assets & tokens)
craly-web/

# ------------------------------------------------------------------------------
# 3. DATABASE FILES & STORAGE (Prevents leaking user/review/hash data)
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
dev.db
aura.db
web/dev.db
web/prisma/dev.db
data/aura.db
data/*.db
data/indexes/*.index
intelligence/data/indexes/*.index

# ------------------------------------------------------------------------------
# 4. LARGE MODEL WEIGHTS & EMBEDDINGS CACHE
# ------------------------------------------------------------------------------
models/embeddings/
models/*.pt
models/*.bin
models/*.onnx
models/*.safetensors
intelligence/models/*.pt
intelligence/models/*.bin

# ------------------------------------------------------------------------------
# 5. DEPENDENCIES & BUILD ARTIFACTS
# ------------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js
dist/
build/
out/
.next/
*.egg-info/
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------------------------------------------
# 6. PYTHON CACHES & VIRTUAL ENVIRONMENTS
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/
env/
ENV/

# ------------------------------------------------------------------------------
# 7. LOGS, DIAGNOSTICS & SCRATCH STORAGE
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
temp/
tmp/
scratch/
coverage/
.nyc_output/
*.dump
*.sql

# ------------------------------------------------------------------------------
# 8. OPERATING SYSTEM & IDE ARTIFACTS
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
.claude/
.agents/
.vercel/
