# AURA.ai Environment Variables
NEXTAUTH_SECRET=aura_default_secret_32_chars_long_key_demo
NEXTAUTH_URL=http://localhost:3000
DATABASE_URL=file:/app/data/aura.db

# OAuth Providers (Optional)
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_ID=
GOOGLE_SECRET=

# AI Intelligence Backend URL (Set automatically in docker-compose)
AURA_INTELLIGENCE_URL=http://intelligence:8000
AURA_AIML_URL=http://intelligence:8000

# Multi-Provider LLM Brain Configuration (Optional: Can also be set directly in-app)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
